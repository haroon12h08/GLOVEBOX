# This .gitignore file should be placed at the root of your Unity project directory
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Zip & archive files
*.zip
*.rar
*.tar.gz

# Memory dumps & crash logs
*.lmp
*.dmp
*.blob
mono_crash*

# Visual Studio / Visual Studio Code / IDE cache & project files
.vs/
.idea/
.vscode/
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.opendb
/*.VC.db
/*.gpState
sysinfo.txt

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
